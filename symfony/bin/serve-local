#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
port="${1:-8877}"
case "$port" in
    *[!0-9]*|'') printf '%s\n' 'Bitte einen gültigen Port angeben.' >&2; exit 1 ;;
esac
if [ "$port" -lt 1 ] || [ "$port" -gt 65535 ]; then
    printf '%s\n' 'Der Port muss zwischen 1 und 65535 liegen.' >&2
    exit 1
fi
if command -v lsof >/dev/null 2>&1 && lsof -nP -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1; then
    if command -v curl >/dev/null 2>&1; then
        login_page="$(curl -fsS --max-time 2 "http://127.0.0.1:$port/login" 2>/dev/null || true)"
        case "$login_page" in
            *'<title>Anmelden · plandito</title>'*)
                printf 'plandito läuft bereits: http://127.0.0.1:%s/\n' "$port"
                exit 0
                ;;
        esac
    fi
    printf 'Port %s ist bereits durch einen anderen Server belegt.\n' "$port" >&2
    exit 1
fi
printf 'plandito starten: http://127.0.0.1:%s/\n' "$port"
exec ./bin/php-local -S "127.0.0.1:$port" -t public router.php

<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Manager anmelden · plandito</title>
  <link rel="icon" type="image/png" href="/assets/plandito-logo.png">
  <link rel="stylesheet" href="/assets/styles.css">
</head>
<body class="login-page">
  <main class="login-card">
    <div class="brand login-brand"><img class="brand-logo" src="/assets/plandito-logo.png" alt="plandito"></div>
    <h1>Mandantenverwaltung</h1>
    <p>Betreiberzugang für Mandanten und Jahresabos. Verwende das eigene Manager-Passwort; das Passwort eines Organisations-Admins gilt hier nicht.</p>
    {% if error %}<p class="message error" role="alert">Benutzername oder Passwort ist ungültig.</p>{% endif %}
    <form method="post" action="{{ path('manager_login') }}" class="login-form">
      <label>Benutzername<input type="text" name="_username" value="{{ last_username ?: 'manager' }}" autocomplete="username" required autofocus></label>
      <label>Passwort<input type="password" name="_password" autocomplete="current-password" required></label>
      <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate_manager') }}">
      <button class="primary" type="submit">Anmelden</button>
    </form>
  </main>
</body>
</html>

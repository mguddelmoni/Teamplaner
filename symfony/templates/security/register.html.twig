<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Organisation registrieren · plandito</title>
  <link rel="icon" type="image/png" href="/assets/plandito-logo.png">
  <link rel="stylesheet" href="/assets/styles.css">
</head>
<body class="login-page">
  <main class="login-card">
    <div class="brand login-brand"><img class="brand-logo" src="/assets/plandito-logo.png" alt="plandito"></div>
    <h1>Organisation registrieren</h1>
    <p>Für jede Organisation entsteht ein eigener Dienstplan. Die Jahresfreischaltung erfolgt nach persönlicher Vereinbarung.</p>
    {% if error %}<p class="message error" role="alert">{{ error }}</p>{% endif %}
    <form method="post" action="{{ path('register_tenant') }}" class="login-form">
      <label>Organisation<input name="name" type="text" maxlength="100" value="{{ name }}" required></label>
      <label>Organisationskürzel <small>für die Login-URL, z. B. /klinik-muster</small><input name="slug" type="text" minlength="3" maxlength="40" pattern="[a-z0-9][a-z0-9-]{2,39}" value="{{ slug }}" required></label>
      <label>Kontakt-E-Mail<input name="email" type="email" maxlength="254" value="{{ email }}" required></label>
      <label>Admin-Passwort <small>mindestens 12 Zeichen</small><input name="password" type="password" minlength="12" maxlength="200" autocomplete="new-password" required></label>
      <input type="hidden" name="_csrf_token" value="{{ csrf_token('register') }}">
      <button class="primary" type="submit">Registrierung absenden</button>
    </form>
    <p><a href="{{ path('login') }}">Zur Anmeldung</a></p>
  </main>
</body>
</html>
